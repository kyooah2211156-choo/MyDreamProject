    "[필수] 개인정보 수집·이용에 동의합니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[Required] I agree to the collection and use of my personal information."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "【必須】個人情報の収集・利用に同意します。"
