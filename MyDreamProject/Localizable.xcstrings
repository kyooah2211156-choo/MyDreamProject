    },
    "'기다려'라고 말하고 한 걸음 물러나요" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say 'stay' and step back once"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「まて」と言って一歩下がります"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói 'chờ' rồi lùi một bước"
          }
        }
      }
    },
    "'앉아' 상태에서 손바닥을 보여 줘요" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While sitting, show your open palm"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「おすわり」の状態で手のひらを見せます"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chó đang ngồi, giơ lòng bàn tay ra"
          }
        }
      }
    },
    "'앉아' 상태에서 손을 내밀어요" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While sitting, hold out your hand"
