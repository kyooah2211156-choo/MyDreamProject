    "동물등록 여부만 체크해 주세요. 등록번호 등은 원장님이 직접 확인해요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just check whether the pet is registered. The director will verify the registration number directly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動物登録の有無だけチェックしてください。登録番号などは園長が直接確認します。"
          }
        },
        "vi" : {
          "stringUnit" : {
