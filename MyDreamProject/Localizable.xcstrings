    "%@님은 경고 %lld회가 되어 이용이 바로 중단돼요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be suspended immediately at %lld warnings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんは警告が%lld回になり、利用がすぐに停止されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ bị tạm ngừng ngay khi đủ %lld lần cảnh cáo."
          }
        }
      }
    },
    "%@님은 로그인할 수 없게 돼요." : {
